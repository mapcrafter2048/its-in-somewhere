{
  "name": "its-in-here-somewhere",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && next build --webpack",
    "preview": "npm run start",
    "test": "node --import tsx tests/run.ts",
    "test:browser": "playwright test",
    "validate": "node --import tsx scripts/validate.ts",
    "test:production": "node scripts/production-smoke.mjs",
    "start": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
